{
  "private": true,
  "name": "strategydance-backend",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development bun --watch src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "test": "bun test",
    "typecheck": "tsc -b",
    "lint": "oxlint -c ../../.oxlintrc.json src",
    "deploy": "gcloud run deploy strategydance-backend --source ../.. --project strategydance --region us-central1 --allow-unauthenticated"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "strategydance-core": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "typescript": "^7.0.2"
  }
}
