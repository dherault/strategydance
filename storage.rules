rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Raster only, and deliberately not `image/.*`: that admits `image/svg+xml`, which is an
    // active document rather than a picture. An SVG carrying a script, stored under a public
    // read and served inline from the storage host, is somebody else's code on that origin
    function isLightImage() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('^image/(png|jpeg|gif|webp)$');
    }

    /*
      One fixed object rather than a `{fileName}` wildcard. A wildcard lets each reader create
      an unbounded number of public objects, and the size check bounds each file rather than
      the bucket: replacing a picture would leave the old one paid for and still served.
      Overwriting one path keeps the count at one per account.

      Public read, because a profile picture is rendered next to its owner's name wherever that
      name appears, and an authenticated fetch for each one buys nothing: the URL is already
      handed to anybody who can see the person
    */
    match /users/{userId}/profile-picture {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && isLightImage();
    }
  }
}
