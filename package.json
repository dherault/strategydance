{
  "private": true,
  "name": "strategydance-monorepo",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run dev:frontend",
    "dev:frontend": "cd packages/frontend && bun run dev",
    "build": "bun run build:frontend",
    "build:frontend": "cd packages/frontend && bun run build",
    "preview": "cd packages/frontend && bun run preview",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "bun run typecheck:core && bun run typecheck:frontend",
    "typecheck:core": "cd packages/strategydance-core && bun run typecheck",
    "typecheck:frontend": "cd packages/frontend && bun run typecheck",
    "ncu": "bun run ncu:root && bun run ncu:core && bun run ncu:frontend && bun install",
    "ncu:root": "ncu -i --cooldown 7d --install never",
    "ncu:core": "cd packages/strategydance-core && ncu -i --cooldown 7d --install never",
    "ncu:frontend": "cd packages/frontend && ncu -i --cooldown 7d --install never",
    "kill": "kill -9 $(lsof -t -i:5173) 2>/dev/null || true",
    "rmnm": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +",
    "clean": "bun run rmnm && bun install",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^24.13.2",
    "husky": "^9.1.7",
    "npm-check-updates": "^23.1.0",
    "oxlint": "^1.82.0"
  }
}
