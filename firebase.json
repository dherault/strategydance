{
  "hosting": {
    "public": "packages/strategydance-web/dist/client",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "redirects": [
      {
        "source": "/-",
        "destination": "/today",
        "type": 301
      },
      {
        "regex": "^/-/(?P<path>[A-Za-z0-9].*)$",
        "destination": "/:path",
        "type": 301
      },
      {
        "regex": "^/(?P<organization>[A-Za-z0-9][A-Za-z0-9-]*)/knowledge/?$",
        "destination": "/:organization/documents",
        "type": 301
      },
      {
        "regex": "^/(?P<organization>[A-Za-z0-9][A-Za-z0-9-]*)/knowledge/(?P<document>[A-Za-z0-9-]+)$",
        "destination": "/:organization/documents/:document",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/_shell.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(png|jpg|jpeg|gif|svg|webp|ico|mp4|webm|mp3|wav|woff|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      },
      {
        "source": "/assets/*",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "regex": "(?i)^/(oauth|integrations)(/.*)?$",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "frame-ancestors 'none'"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          }
        ]
      }
    ]
  },
  "dataconnect": {
    "source": "packages/strategydance-database"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "singleProjectMode": true,
    "ui": {
      "enabled": true
    },
    "auth": {
      "port": 9099
    },
    "dataconnect": {
      "port": 9399,
      "dataDir": "./emulators-data/dataconnect"
    },
    "hosting": {
      "port": 5050
    },
    "storage": {
      "port": 9199
    }
  }
}
