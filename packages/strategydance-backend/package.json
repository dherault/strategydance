{
  "private": true,
  "name": "strategydance-backend",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development FIREBASE_AUTH_EMULATOR_HOST=localhost:9099 DATA_CONNECT_EMULATOR_HOST=localhost:9399 FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199 bun --watch src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "test": "bun test --isolate",
    "typecheck": "tsc -b",
    "lint": "oxlint -c ../../.oxlintrc.json src scripts",
    "grant:administrator": "DATA_CONNECT_EMULATOR_HOST=localhost:9399 bun scripts/grantAdministrator.ts",
    "check:conversation-list": "DATA_CONNECT_EMULATOR_HOST=localhost:9399 bun scripts/checkConversationList.ts",
    "check:conversation-page": "DATA_CONNECT_EMULATOR_HOST=localhost:9399 bun scripts/checkConversationPage.ts",
    "check:conversation-runs": "DATA_CONNECT_EMULATOR_HOST=localhost:9399 bun scripts/checkConversationRuns.ts",
    "check:conversation-search": "DATA_CONNECT_EMULATOR_HOST=localhost:9399 bun scripts/checkConversationSearch.ts",
    "probe:claude": "bun scripts/probeClaude.ts",
    "send:conversation": "FIREBASE_AUTH_EMULATOR_HOST=localhost:9099 DATA_CONNECT_EMULATOR_HOST=localhost:9399 bun scripts/sendConversationMessage.ts",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@google-cloud/secret-manager": "^7.1.0",
    "@google-cloud/tasks": "^7.2.1",
    "@modelcontextprotocol/client": "^2.2.0",
    "@modelcontextprotocol/server": "^2.2.0",
    "cors": "^2.8.6",
    "entities": "^4.5.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "firebase-admin": "^14.4.0",
    "google-gax": "^6.4.0",
    "ipaddr.js": "^2.2.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "resend": "^6.28.1",
    "strategydance-core": "workspace:*",
    "strategydance-database": "workspace:*",
    "strategydance-design-system": "workspace:*",
    "strategydance-emails": "workspace:*",
    "yjs": "^13.6.27",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "typescript": "^7.0.2"
  }
}
