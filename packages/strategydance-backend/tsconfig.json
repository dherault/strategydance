{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Custom */
    "esModuleInterop": true,
    "types": ["bun"],

    /* Path aliases, resolved relative to this file. Bun reads them at runtime as well */
    "paths": {
      "~constants": ["./src/constants.ts"],
      "~firebase": ["./src/firebase.ts"],
      "~types": ["./src/types.ts"],
      "~domain/*": ["./src/domain/*"],
      "~middleware/*": ["./src/middleware/*"],
      "~routes/*": ["./src/routes/*"],
      "~utils/*": ["./src/utils/*"]
    }
  },
  "include": ["src"]
}
