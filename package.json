{
  "private": true,
  "name": "strategydance-monorepo",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run dev:web",
    "dev:web": "cd packages/strategydance-web && bun run dev",
    "dev:emulators": "mkdir -p emulators-data && firebase emulators:start --only auth,dataconnect,storage --import=./emulators-data --export-on-exit=./emulators-data",
    "build": "bun run build:web",
    "build:web": "cd packages/strategydance-web && bun run build",
    "preview": "VITE_USE_FIREBASE_EMULATORS=true bun run build && firebase emulators:start --only hosting,auth,dataconnect,storage",
    "deploy:hosting": "bun run build && firebase deploy --only hosting",
    "deploy:storage": "firebase deploy --only storage",
    "deploy:database": "firebase deploy --only dataconnect",
    "ship": "bash scripts/ship.sh",
    "generate:database": "cd packages/strategydance-database && bun run generate",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "bun test",
    "translate": "cd packages/strategydance-translations && bun run translate",
    "typecheck": "bun run typecheck:core && bun run typecheck:database && bun run typecheck:design-system && bun run typecheck:translations && bun run typecheck:web",
    "typecheck:core": "cd packages/strategydance-core && bun run typecheck",
    "typecheck:database": "cd packages/strategydance-database && bun run typecheck",
    "typecheck:design-system": "cd packages/strategydance-design-system && bun run typecheck",
    "typecheck:translations": "cd packages/strategydance-translations && bun run typecheck",
    "typecheck:web": "cd packages/strategydance-web && bun run typecheck",
    "ncu": "bun run ncu:root && bun run ncu:core && bun run ncu:database && bun run ncu:design-system && bun run ncu:translations && bun run ncu:web && bun install",
    "ncu:root": "ncu -i --cooldown 7d --install never",
    "ncu:core": "cd packages/strategydance-core && ncu -i --cooldown 7d --install never",
    "ncu:database": "cd packages/strategydance-database && ncu -i --cooldown 7d --install never --dep prod,dev,optional,peer",
    "ncu:design-system": "cd packages/strategydance-design-system && ncu -i --cooldown 7d --install never",
    "ncu:translations": "cd packages/strategydance-translations && ncu -i --cooldown 7d --install never",
    "ncu:web": "cd packages/strategydance-web && ncu -i --cooldown 7d --install never",
    "kill": "kill -9 $(lsof -t -i:5173) 2>/dev/null || true",
    "kill:emulators": "kill -9 $(lsof -t -i:4000 -i:5050 -i:9099 -i:9199 -i:9399) 2>/dev/null || true",
    "rmnm": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +",
    "clean": "bun run rmnm && bun install",
    "prepare": "husky",
    "postinstall": "bun run generate:database"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^24.13.2",
    "firebase-tools": "^15.30.1",
    "husky": "^9.1.7",
    "npm-check-updates": "^23.1.0",
    "oxlint": "^1.83.0"
  }
}
